    "/api/v1/usuarios/yo/telefono": {
      "put": {
        "summary": "Teléfono E.164, guardado como HMAC-SHA-256",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
