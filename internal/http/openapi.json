      }
    },
    "/api/v1/usuarios/yo/cancelar-eliminacion": {
      "post": {
        "summary": "Cancela la eliminación dentro del plazo",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Perfil"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/usuarios/exportaciones/descargar": {
      "post": {
        "summary": "Descarga mis datos con el enlace de un solo uso (D-2); el archivo se borra al descargarlo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON con un objeto por módulo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/ciudades/autocompletar": {
      "get": {
        "summary": "Autocompletado de ciudades por prefijo",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 8,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ciudades",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "nombre": {
                        "type": "string"
                      },
                      "estado": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Error uniforme",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "estado",
          "version"
        ],
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Ready": {
        "type": "object",
        "required": [
          "estado",
          "dependencias"
        ],
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "error"
            ]
          },
          "dependencias": {
            "type": "object",
            "properties": {
              "mongodb": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "redis": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "neo4j": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "indices_mongodb": {
                "type": "string",
                "enum": [
                  "ok",
                  "error"
                ],
                "description": "Índices declarados presentes (nv-04); error = falta correr scripts/indexes"
              }
            }
          }
        }
      },
      "Ping": {
        "type": "object",
        "required": [
          "estado"
        ],
        "properties": {
          "estado": {
            "type": "string",
            "enum": [
              "pong"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "codigo",
          "mensaje",
          "campos",
          "traza_id"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "campos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "mensaje": {
                  "type": "string"
                }
              }
            }
          },
          "detalle": {
            "type": "string",
            "description": "Solo fuera de prod"
          },
          "traza_id": {
            "type": "string"
          }
        }
      },
      "Dispositivo": {
        "type": "object",
        "required": [
          "modelo",
          "sistema"
        ],
        "properties": {
          "modelo": {
            "type": "string",
            "maxLength": 80
          },
          "sistema": {
            "type": "string",
            "maxLength": 40
          },
          "app_version": {
            "type": "string",
            "maxLength": 40
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "correo": {
            "type": "string",
            "format": "email"
          },
          "correo_verificado": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "consumidor",
                "comerciante",
                "administrador"
              ]
            }
          }
        }
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT HS256 de 15 min"
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaco, 30 días, rota en cada uso"
          },
          "expira_en": {
            "type": "string",
            "format": "date-time",
            "description": "Vencimiento del access token (UTC)"
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          }
        }
      },
      "Sesion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "dispositivo": {
            "$ref": "#/components/schemas/Dispositivo"
          },
          "ultimo_uso": {
            "type": "string",
            "format": "date-time"
          },
          "actual": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "correo",
          "password",
          "dispositivo"
        ],
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 128
          },
          "dispositivo": {
            "$ref": "#/components/schemas/Dispositivo"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "CorreoRequest": {
        "type": "object",
        "required": [
          "correo"
        ],
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "RestablecerRequest": {
        "type": "object",
        "required": [
          "token",
          "password_nuevo"
        ],
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128
          },
          "password_nuevo": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Al menos una letra y un número"
          },
          "dispositivo": {
            "$ref": "#/components/schemas/Dispositivo"
          }
        }
      },
      "TokenEnlaceRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "PasswordRequest": {
        "type": "object",
        "required": [
          "password_actual",
          "password_nuevo"
        ],
        "properties": {
          "password_actual": {
            "type": "string",
            "maxLength": 128
          },
          "password_nuevo": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Al menos una letra y un número"
          }
        }
      },
      "Gustos": {
        "type": "object",
        "properties": {
          "categorias": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 10
          },
          "presupuesto_min": {
            "type": "integer"
          },
          "presupuesto_max": {
            "type": "integer"
          },
          "restricciones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alergias": {
            "type": "string"
          }
        }
      },
      "Preferencias": {
        "type": "object",
        "properties": {
          "movilidad_default": {
            "type": "string",
            "enum": [
              "a_pie",
              "bicicleta",
              "auto",
              "transporte_publico"
            ]
          },
          "tema": {
            "type": "string",
            "enum": [
              "claro",
              "oscuro",
              "sistema"
            ]
          },
          "unidades": {
            "type": "string",
            "enum": [
              "km",
              "mi"
            ]
          },
          "horario_silencioso": {
            "type": "object",
            "nullable": true,
            "properties": {
              "desde": {
                "type": "string",
                "example": "22:00"
              },
              "hasta": {
                "type": "string",
                "example": "07:00"
              }
            }
          },
          "notificaciones": {
            "type": "object",
            "properties": {
              "reservas": {
                "type": "boolean"
              },
              "cupones": {
                "type": "boolean"
              },
              "grupos": {
                "type": "boolean"
              },
              "resenas": {
                "type": "boolean"
              },
              "promociones": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Privacidad": {
        "type": "object",
        "properties": {
          "ubicacion": {
            "type": "boolean"
          },
          "aprendizaje_personalizado": {
            "type": "boolean"
          },
          "estado_animo": {
            "type": "boolean"
          },
          "datos_uso": {
            "type": "boolean"
          },
          "buscable_por_telefono": {
            "type": "boolean"
          },
          "promociones_correo": {
            "type": "boolean"
          },
          "version_terminos": {
            "type": "string"
          },
          "fecha_aceptacion": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Perfil": {
        "type": "object",
        "description": "Nunca incluye password_hash, telefono_hash ni google_id.",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          },
          "correo_verificado": {
            "type": "boolean"
          },
          "foto_url": {
            "type": "string"
          },
          "codigo_amigo": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modo_actual": {
            "type": "string",
            "enum": [
              "explorar",
              "negocio"
            ]
          },
          "ciudad": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "nombre": {
                "type": "string"
              }
            }
          },
          "gustos": {
            "$ref": "#/components/schemas/Gustos"
          },
          "preferencias": {
            "$ref": "#/components/schemas/Preferencias"
          },
          "privacidad": {
            "$ref": "#/components/schemas/Privacidad"
          },
          "telefono_registrado": {
            "type": "boolean"
          },
          "puntos": {
            "type": "integer"
          },
          "nivel": {
            "type": "string"
          },
          "racha_semanas": {
            "type": "integer"
          },
          "estado": {
            "type": "string",
            "enum": [
              "activo",
              "bloqueado",
              "eliminacion_pendiente"
            ]
          },
          "eliminar_en": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "version": {
            "type": "integer"
          },
          "creado_en": {
            "type": "string",
            "format": "date-time"
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegistroRequest": {
        "type": "object",
        "required": [
          "nombre",
          "fecha_nacimiento",
          "correo",
          "password",
          "acepta_terminos",
          "version_terminos"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date",
            "description": "18 años o más (UTC)"
          },
          "correo": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "acepta_terminos": {
            "type": "boolean"
          },
          "version_terminos": {
            "type": "string"
          },
          "promociones_correo": {
            "type": "boolean"
          },
          "dispositivo": {
            "$ref": "#/components/schemas/Dispositivo"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
