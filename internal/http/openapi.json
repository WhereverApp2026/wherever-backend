    "/api/v1/usuarios/yo/modo": {
      "post": {
        "summary": "Cambia entre explorar y negocio",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
