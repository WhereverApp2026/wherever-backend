{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrailDelProyecto",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:CreateTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:DeleteTrail",
        "cloudtrail:StartLogging",
        "cloudtrail:StopLogging",
        "cloudtrail:GetTrail",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:GetEventSelectors",
        "cloudtrail:PutEventSelectors",
        "cloudtrail:GetInsightSelectors",
        "cloudtrail:AddTags",
        "cloudtrail:RemoveTags",
        "cloudtrail:ListTags"
      ],
      "Resource": "arn:aws:cloudtrail:us-east-2:816101201001:trail/wherever-dev-*"
    },
    {
      "Sid": "TrailsSinRecursoAcotable",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:ListTrails"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BucketDeAuditoria",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:Get*",
        "s3:List*",
        "s3:Put*"
      ],
      "Resource": "arn:aws:s3:::wherever-dev-auditoria-816101201001"
    },
    {
      "Sid": "VaciarAuditoriaAlDestruir",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::wherever-dev-auditoria-816101201001/*"
    },
    {
      "Sid": "AuditoriaNuncaPublica",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketAcl",
        "s3:PutObjectAcl",
        "s3:PutBucketWebsite"
      ],
      "Resource": [
        "arn:aws:s3:::wherever-dev-auditoria-816101201001",
        "arn:aws:s3:::wherever-dev-auditoria-816101201001/*"
      ]
    },
    {
      "Sid": "PasarRolSoloACloudTrail",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::816101201001:role/wherever-dev-cloudtrail",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudtrail.amazonaws.com"
        }
      }
    }
  ]
}
