# Plantilla de configuración. Copiar a .env (git-ignored) y reemplazar los marcadores.
# Nunca poner valores reales aquí. Solo claves que lee internal/platform/config.
# Las tres bases apuntan a deployments/docker-compose.yml (make infra-up), sin credenciales.
# REDIS_ADDR acepta también una URL rediss:// y NEO4J_URI una neo4j+s:// con credenciales (nv-11).
APP_ENV=dev
PORT=8080
MONGO_URI=mongodb://localhost:27017/wherever
REDIS_ADDR=localhost:6379
NEO4J_URI=neo4j://localhost:7687
# Mínimo 32 bytes. El marcador hace fallar el arranque a propósito.
JWT_KEY=PLACEHOLDER_MIN_32_BYTES
JWT_ISSUER=wherever-api
JWT_AUDIENCE=wherever-app
# Vida de los tokens; se pueden bajar, nunca subir (access 15 min, refresh 30 días).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Llave del HMAC-SHA-256 de teléfonos (hoja A1). Mínimo 32 bytes; el marcador falla a propósito.
PHONE_HMAC_KEY=PLACEHOLDER_MIN_32_BYTES
# Días antes de borrar una cuenta que pidió eliminarse (1 a 30).
ARCO_DIAS_GRACIA=30
# Un solo origen (http(s)://host[:puerto]). Vacío = sin CORS.
CORS_ALLOWED_ORIGIN=
# Hora (0 a 23, America/Mexico_City) del trabajo nocturno de privacidad; debe caer con el servidor encendido.
JOB_HOUR=3
# true oculta `detalle` y las sondas en un servidor público que no sea prod (en prod siempre ocultos).
HIDE_INTERNALS=false
# IPs o CIDR de proxies de confianza separados por coma. Vacío = se ignora X-Forwarded-For.
TRUSTED_PROXIES=
# Proxies de confianza que escriben en X-Forwarded-For: 2 con CloudFront y balanceador.
TRUSTED_PROXY_HOPS=1
# Opcionales; se pueden bajar, nunca subir (10 MB, 60s, 1000/min, 10 escrituras simultáneas).
BODY_LIMIT=10485760
REQUEST_TIMEOUT=60s
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_WRITES=10
# Correo saliente (nv-06). Sin SMTP_HOST, dev y staging solo registran en el log; prod no arranca.
# Con `make mail-dev` (Mailpit): SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_TLS=none, sin usuario.
SMTP_HOST=
SMTP_PORT=587
# Usuario y contraseña del proveedor, solo en .env o Secrets Manager; nunca aquí.
SMTP_USER=
SMTP_PASSWORD=
# starttls (587), tls (465) o none (solo fuera de prod y sin usuario).
SMTP_TLS=starttls
MAIL_FROM=no-responder@wherever.local
MAIL_TIMEOUT=5s
MAIL_WORKERS=4
MAIL_QUEUE_SIZE=100
# Base de los enlaces de los correos; en prod solo https://. El token va en el fragmento (#token=).
APP_LINK_BASE=http://localhost:8080
